<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin - My Shop</title>

    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            margin: 0;
            background: #0f1117;
            color: white;
        }

        .container {
            max-width: 1250px;
            margin: 40px auto;
            padding: 20px;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        h1 {
            margin: 0;
            font-size: 28px;
        }

        .logout {
            color: #aaa;
            text-decoration: none;
            padding: 10px 15px;
            border: 1px solid #333;
            border-radius: 8px;
        }

        .logout:hover {
            color: white;
            background: #1d2029;
        }

        /* THỐNG KÊ */

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 25px;
        }

        .stat {
            background: #181b24;
            border: 1px solid #292d38;
            border-radius: 14px;
            padding: 20px;
        }

        .stat-title {
            color: #999;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .stat-number {
            font-size: 26px;
            font-weight: bold;
        }

        /* BẢNG */

        .table-box {
            overflow-x: auto;
            background: #181b24;
            border-radius: 15px;
            border: 1px solid #292d38;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #292d38;
            white-space: nowrap;
        }

        th {
            color: #888;
            font-size: 14px;
        }

        td {
            color: #ddd;
        }

        tr:hover {
            background: #1d2029;
        }

        select {
            padding: 8px 10px;
            background: #101218;
            color: white;
            border: 1px solid #444;
            border-radius: 7px;
            cursor: pointer;
        }

        button {
            padding: 8px 13px;
            margin-left: 5px;
            border: none;
            border-radius: 7px;
            background: #6c63ff;
            color: white;
            cursor: pointer;
        }

        button:hover {
            background: #7b73ff;
        }

        .empty {
            text-align: center;
            padding: 50px;
            color: #777;
        }

        .order-id {
            font-weight: bold;
        }

        @media (max-width: 800px) {
            .stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 500px) {
            .stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <div class="top">

        <h1>📦 Quản lý đơn hàng</h1>

        <a href="/admin/logout" class="logout">
            Đăng xuất
        </a>

    </div>


    <!-- ================= THỐNG KÊ ================= -->

    <%
        const totalOrders = orders.length;

        const pendingOrders = orders.filter(
            order => order.status === "Chờ xử lý"
        ).length;

        const completedOrders = orders.filter(
            order => order.status === "Hoàn thành"
        ).length;

        let revenue = 0;

        orders.forEach(order => {

            if (order.status === "Hoàn thành") {

                const number = Number(
                    order.price
                        .replace(/\./g, "")
                        .replace("đ", "")
                );

                revenue += number;
            }

        });

        const formattedRevenue = revenue.toLocaleString("vi-VN") + "đ";
    %>


    <div class="stats">

        <div class="stat">
            <div class="stat-title">
                📦 Tổng đơn hàng
            </div>

            <div class="stat-number">
                <%= totalOrders %>
            </div>
        </div>


        <div class="stat">
            <div class="stat-title">
                💰 Doanh thu
            </div>

            <div class="stat-number">
                <%= formattedRevenue %>
            </div>
        </div>


        <div class="stat">
            <div class="stat-title">
                🟡 Chờ xử lý
            </div>

            <div class="stat-number">
                <%= pendingOrders %>
            </div>
        </div>


        <div class="stat">
            <div class="stat-title">
                🟢 Hoàn thành
            </div>

            <div class="stat-number">
                <%= completedOrders %>
            </div>
        </div>

    </div>


    <!-- ================= DANH SÁCH ĐƠN ================= -->

    <div class="table-box">

        <% if (orders.length === 0) { %>

            <div class="empty">
                Chưa có đơn hàng nào.
            </div>

        <% } else { %>

            <table>

                <thead>

                    <tr>
                        <th>Mã đơn</th>
                        <th>Sản phẩm</th>
                        <th>Khách hàng</th>
                        <th>Email</th>
                        <th>Giá</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                    </tr>

                </thead>


                <tbody>

                    <% orders.forEach(order => { %>

                        <tr>

                            <td class="order-id">
                                #<%= order.id %>
                            </td>


                            <td>
                                <%= order.product %>
                            </td>


                            <td>
                                <%= order.name %>
                            </td>


                            <td>
                                <%= order.email %>
                            </td>


                            <td>
                                <%= order.price %>
                            </td>


                            <td>
                                <%= order.time %>
                            </td>


                            <td>

                                <form
                                    action="/admin/order/<%= order.id %>/status"
                                    method="POST"
                                >

                                    <select name="status">

                                        <option
                                            value="Chờ xử lý"
                                            <%= order.status === "Chờ xử lý" ? "selected" : "" %>
                                        >
                                            🟡 Chờ xử lý
                                        </option>


                                        <option
                                            value="Đang xử lý"
                                            <%= order.status === "Đang xử lý" ? "selected" : "" %>
                                        >
                                            🔵 Đang xử lý
                                        </option>


                                        <option
                                            value="Hoàn thành"
                                            <%= order.status === "Hoàn thành" ? "selected" : "" %>
                                        >
                                            🟢 Hoàn thành
                                        </option>


                                        <option
                                            value="Đã hủy"
                                            <%= order.status === "Đã hủy" ? "selected" : "" %>
                                        >
                                            🔴 Đã hủy
                                        </option>

                                    </select>


                                    <button type="submit">
                                        Lưu
                                    </button>

                                </form>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        <% } %>

    </div>

</div>

</body>
</html>