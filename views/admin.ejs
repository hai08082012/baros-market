<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Admin - Baro's Market</title>

<style>
*{
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    margin:0;
    background:#0b0d12;
    color:white;
}

.container{
    width:94%;
    max-width:1200px;
    margin:40px auto;
}

.header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:30px;
}

h1{
    margin:0;
}

.logout{
    background:#292d38;
    color:white;
    padding:10px 16px;
    border-radius:8px;
    text-decoration:none;
}

.box{
    background:#151821;
    border:1px solid #292d38;
    border-radius:16px;
    padding:25px;
    margin-bottom:25px;
}

h2{
    margin-top:0;
}

.table-wrap{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:700px;
}

th,td{
    padding:14px 10px;
    border-bottom:1px solid #292d38;
    text-align:left;
}

th{
    color:#aaa;
}

.balance{
    color:#6c63ff;
    font-weight:bold;
}

input{
    background:#0b0d12;
    color:white;
    border:1px solid #363a46;
    border-radius:7px;
    padding:9px;
    width:120px;
}

button{
    border:0;
    padding:9px 13px;
    border-radius:7px;
    color:white;
    cursor:pointer;
    font-weight:bold;
}

.add{
    background:#168a4a;
}

.remove{
    background:#b93636;
}

.status{
    background:#0b0d12;
    color:white;
    border:1px solid #363a46;
    padding:8px;
    border-radius:7px;
}

.back{
    color:#8d87ff;
    text-decoration:none;
}
</style>
</head>

<body>

<div class="container">

    <div class="header">
        <h1>⚙️ Quản trị Baro's Market</h1>

        <a href="/admin/logout" class="logout">
            Đăng xuất
        </a>
    </div>


    <!-- ================= KHÁCH HÀNG ================= -->

    <div class="box">

        <h2>👥 Quản lý tài khoản khách hàng</h2>

        <div class="table-wrap">

        <table>

            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Email</th>
                <th>Số dư</th>
                <th>Ngày đăng ký</th>
                <th>Thao tác</th>
            </tr>

            <% if (users.length === 0) { %>

                <tr>
                    <td colspan="6">
                        Chưa có khách hàng.
                    </td>
                </tr>

            <% } %>


            <% users.forEach(user => { %>

            <tr>

                <td>
                    #<%= user.id %>
                </td>

                <td>
                    👤 <%= user.username %>
                </td>

                <td>
                    <%= user.email %>
                </td>

                <td class="balance">
                    <%= user.balance.toLocaleString("vi-VN") %>đ
                </td>

                <td>
                    <%= user.time %>
                </td>

                <td>

                    <form
                        action="/admin/user/<%= user.id %>/balance"
                        method="POST"
                        style="display:inline-flex;gap:5px;flex-wrap:wrap;"
                    >

                        <input
                            type="number"
                            name="amount"
                            min="1"
                            placeholder="Số tiền"
                            required
                        >

                        <button
                            type="submit"
                            name="action"
                            value="add"
                            class="add"
                        >
                            + Cộng
                        </button>

                        <button
                            type="submit"
                            name="action"
                            value="remove"
                            class="remove"
                        >
                            − Trừ
                        </button>

                    </form>

                </td>

            </tr>

            <% }) %>

        </table>

        </div>

    </div>


    <!-- ================= ĐƠN HÀNG ================= -->

    <div class="box">

        <h2>📦 Quản lý đơn hàng</h2>

        <div class="table-wrap">

        <table>

            <tr>
                <th>Mã đơn</th>
                <th>Sản phẩm</th>
                <th>Khách hàng</th>
                <th>Email</th>
                <th>Giá</th>
                <th>Thời gian</th>
                <th>Trạng thái</th>
            </tr>

            <% if (orders.length === 0) { %>

                <tr>
                    <td colspan="7">
                        Chưa có đơn hàng.
                    </td>
                </tr>

            <% } %>


            <% orders.forEach(order => { %>

            <tr>

                <td>
                    #<%= order.id %>
                </td>

                <td>
                    <%= order.product %>
                </td>

                <td>
                    <%= order.name %>
                </td>

                <td>
                    <%= order.email %>
                </td>

                <td>
                    <%= order.price %>
                </td>

                <td>
                    <%= order.time %>
                </td>

                <td>

                    <form
                        action="/admin/order/<%= order.id %>/status"
                        method="POST"
                    >

                        <select
                            name="status"
                            class="status"
                            onchange="this.form.submit()"
                        >

                            <option
                                value="Chờ thanh toán"
                                <%= order.status === "Chờ thanh toán" ? "selected" : "" %>
                            >
                                Chờ thanh toán
                            </option>

                            <option
                                value="Chờ xác nhận thanh toán"
                                <%= order.status === "Chờ xác nhận thanh toán" ? "selected" : "" %>
                            >
                                Chờ xác nhận
                            </option>

                            <option
                                value="Đã thanh toán"
                                <%= order.status === "Đã thanh toán" ? "selected" : "" %>
                            >
                                Đã thanh toán
                            </option>

                            <option
                                value="Đang xử lý"
                                <%= order.status === "Đang xử lý" ? "selected" : "" %>
                            >
                                Đang xử lý
                            </option>

                            <option
                                value="Hoàn thành"
                                <%= order.status === "Hoàn thành" ? "selected" : "" %>
                            >
                                Hoàn thành
                            </option>

                            <option
                                value="Đã hủy"
                                <%= order.status === "Đã hủy" ? "selected" : "" %>
                            >
                                Đã hủy
                            </option>

                        </select>

                    </form>

                </td>

            </tr>

            <% }) %>

        </table>

        </div>

    </div>


    <a href="/" class="back">
        ← Về trang chủ
    </a>

</div>

</body>
</html>