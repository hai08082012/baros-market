<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Đăng ký - Baro's Market</title>
<style>
body{margin:0;background:#0b0d12;color:white;font-family:Arial;display:flex;justify-content:center;align-items:center;min-height:100vh}
.box{width:360px;background:#151821;padding:30px;border-radius:15px;border:1px solid #292d38}
h2{text-align:center}
input{width:100%;padding:12px;margin:8px 0;box-sizing:border-box;background:#0b0d12;color:white;border:1px solid #333;border-radius:7px}
button{width:100%;padding:12px;margin-top:10px;background:#6c63ff;color:white;border:0;border-radius:7px;font-weight:bold}
.error{color:#ff6b6b;text-align:center}
a{color:#8b84ff}
</style>
</head>
<body>
<div class="box">
<h2>Đăng ký tài khoản</h2>

<% if (error) { %>
<p class="error"><%= error %></p>
<% } %>

<form method="POST" action="/register">
<input name="username" placeholder="Tên tài khoản" required>
<input name="email" type="email" placeholder="Email" required>
<input name="password" type="password" placeholder="Mật khẩu" required>
<button>Đăng ký</button>
</form>

<p>Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
</div>
</body>
</html>