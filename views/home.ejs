<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Baro's Market</title>

    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: #0b0d12;
            color: white;
        }

        a {
            text-decoration: none;
        }

        /* ================= HEADER ================= */

        header {
            height: 72px;
            display: flex;
            align-items: center;
            padding: 0 6%;
            background: rgba(13, 15, 21, 0.97);
            border-bottom: 1px solid #252936;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(10px);
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            white-space: nowrap;
        }

        .logo span {
            color: #6c63ff;
        }

        nav {
            display: flex;
            gap: 28px;
            margin-left: 55px;
        }

        nav a {
            color: #999;
            transition: 0.2s;
        }

        nav a:hover {
            color: white;
        }

        .account {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .account a {
            padding: 10px 14px;
            border-radius: 9px;
            color: white;
            transition: 0.2s;
        }

        .balance {
            background: #171a24;
            border: 1px solid #2a2e3b;
        }

        .balance:hover {
            border-color: #6c63ff;
        }

        .user {
            background: #6c63ff;
            font-weight: bold;
        }

        .user:hover,
        .register:hover {
            background: #7b73ff;
        }

        .login {
            color: #aaa !important;
        }

        .login:hover {
            color: white !important;
        }

        .register {
            background: #6c63ff;
            font-weight: bold;
        }

        /* ================= HERO ================= */

        .hero {
            min-height: 500px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 80px 20px;

            background:
                radial-gradient(
                    circle at center,
                    #252452 0%,
                    #11131c 45%,
                    #0b0d12 78%
                );
        }

        .hero-content {
            width: 100%;
            max-width: 850px;
        }

        .badge {
            display: inline-block;
            padding: 8px 15px;
            border-radius: 50px;
            background: #1d1c3c;
            color: #aaa5ff;
            border: 1px solid #383471;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: 54px;
            line-height: 1.1;
            margin: 10px 0 20px;
        }

        .hero h1 span {
            color: #6c63ff;
        }

        .hero p {
            color: #999;
            font-size: 18px;
            line-height: 1.6;
            max-width: 650px;
            margin: auto;
        }

        .hero-btn {
            display: inline-block;
            margin-top: 28px;
            padding: 14px 28px;
            background: #6c63ff;
            color: white;
            border-radius: 9px;
            font-weight: bold;
            transition: 0.2s;
        }

        .hero-btn:hover {
            background: #7b73ff;
            transform: translateY(-2px);
        }

        /* ================= SEARCH ================= */

        .search-area {
            padding: 35px 8% 0;
        }

        .search-box {
            max-width: 800px;
            margin: auto;
            position: relative;
        }

        .search-box input {
            width: 100%;
            padding: 16px 20px;
            background: #151821;
            border: 1px solid #292d38;
            border-radius: 12px;
            color: white;
            font-size: 15px;
            outline: none;
        }

        .search-box input:focus {
            border-color: #6c63ff;
        }

        /* ================= PRODUCTS ================= */

        .products {
            padding: 70px 8% 80px;
        }

        .section-title {
            text-align: center;
            margin-bottom: 40px;
        }

        .section-title h2 {
            font-size: 32px;
            margin: 0 0 10px;
        }

        .section-title p {
            color: #777;
            margin: 0;
        }

        .product-list {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .product {
            position: relative;
            background: #151821;
            padding: 30px;
            border: 1px solid #292d38;
            border-radius: 16px;
            transition: 0.25s;
        }

        .product:hover {
            transform: translateY(-5px);
            border-color: #6c63ff;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .popular {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 6px 10px;
            border-radius: 6px;
            background: #6c63ff;
            font-size: 11px;
            font-weight: bold;
        }

        .product-icon {
            font-size: 38px;
            margin-bottom: 18px;
        }

        .product h3 {
            font-size: 21px;
            margin: 0 0 10px;
        }

        .product p {
            color: #888;
            line-height: 1.5;
            min-height: 45px;
        }

        .price {
            font-size: 24px;
            font-weight: bold;
            margin: 25px 0;
        }

        .btn {
            display: block;
            text-align: center;
            padding: 13px 20px;
            background: #6c63ff;
            color: white;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.2s;
        }

        .btn:hover {
            background: #7b73ff;
        }

        /* ================= NOTICE ================= */

        .notice {
            padding: 10px 8% 70px;
        }

        .notice-box {
            max-width: 1100px;
            margin: auto;
            padding: 25px 30px;
            background: #151821;
            border: 1px solid #292d38;
            border-radius: 15px;
        }

        .notice-box h2 {
            margin: 0 0 10px;
            font-size: 21px;
        }

        .notice-box p {
            color: #888;
            margin: 0;
            line-height: 1.6;
        }

        /* ================= INFO ================= */

        .info {
            padding: 0 8% 80px;
        }

        .info-list {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            max-width: 1100px;
            margin: auto;
        }

        .info-box {
            text-align: center;
            padding: 28px 20px;
            background: #151821;
            border: 1px solid #292d38;
            border-radius: 14px;
        }

        .info-box .icon {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .info-box h3 {
            margin: 10px 0;
        }

        .info-box p {
            color: #888;
            margin: 0;
            line-height: 1.5;
        }

        /* ================= CONTACT ================= */

        .contact {
            padding: 0 8% 90px;
        }

        .contact-container {
            max-width: 900px;
            margin: auto;
            padding: 40px;
            background: #151821;
            border: 1px solid #292d38;
            border-radius: 18px;
        }

        .contact-title {
            text-align: center;
            margin-bottom: 30px;
        }

        .contact-icon {
            width: 55px;
            height: 55px;
            margin: 0 auto 15px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #1c1b3a;
            border: 1px solid #36326e;
            border-radius: 14px;

            font-size: 26px;
        }

        .contact-title h2 {
            margin: 0 0 10px;
            font-size: 30px;
        }

        .contact-title p {
            color: #888;
            margin: 0;
            line-height: 1.6;
        }

        .contact-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .contact-box {
            display: flex;
            align-items: center;
            gap: 15px;

            padding: 20px;

            background: #10121a;
            border: 1px solid #292d38;
            border-radius: 12px;

            color: white;

            transition: 0.2s;
        }

        .contact-box:hover {
            border-color: #6c63ff;
            transform: translateY(-3px);
        }

        .contact-box-icon {
            width: 45px;
            height: 45px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #1c1b3a;
            border-radius: 10px;

            font-size: 22px;
        }

        .contact-box h3 {
            margin: 0 0 5px;
        }

        .contact-box p {
            margin: 0;
            color: #777;
            font-size: 14px;
        }

        /* ================= FOOTER ================= */

        footer {
            text-align: center;
            padding: 30px;
            border-top: 1px solid #242833;
            color: #666;
        }

        /* ================= MOBILE ================= */

        @media (max-width: 800px) {

            header {
                padding: 0 4%;
            }

            .logo {
                font-size: 20px;
            }

            nav {
                display: none;
            }

            .account {
                gap: 4px;
            }

            .account a {
                padding: 8px 9px;
                font-size: 12px;
            }

            .hero h1 {
                font-size: 38px;
            }

            .product-list {
                grid-template-columns: 1fr;
            }

            .info-list {
                grid-template-columns: 1fr;
            }

            .contact-list {
                grid-template-columns: 1fr;
            }

            .contact-container {
                padding: 30px 20px;
            }
        }
    </style>
</head>

<body>

<!-- ================= HEADER ================= -->

<header>

    <div class="logo">
        Baro's <span>Market</span>
    </div>

    <nav>
        <a href="/">Trang chủ</a>
        <a href="#products">Sản phẩm</a>
        <a href="#contact">Liên hệ</a>
    </nav>

    <div class="account">

        <% if (user) { %>

            <a href="/account" class="balance">
                💰 <%= Number(user.balance || 0).toLocaleString("vi-VN") %>đ
            </a>

            <a href="/account" class="user">
                👤 <%= user.username %>
            </a>

        <% } else { %>

            <a href="/login" class="login">
                Đăng nhập
            </a>

            <a href="/register" class="register">
                Đăng ký
            </a>

        <% } %>

    </div>

</header>


<!-- ================= HERO ================= -->

<section class="hero">

    <div class="hero-content">

        <div class="badge">
            ⚡ Dịch vụ online nhanh chóng
        </div>

        <h1>
            Chào mừng đến<br>
            <span>Baro's Market</span>
        </h1>

        <p>
            Cung cấp các dịch vụ online nhanh chóng,
            tiện lợi và dễ sử dụng.
        </p>

        <a href="#products" class="hero-btn">
            🛍️ Xem sản phẩm
        </a>

    </div>

</section>


<!-- ================= SEARCH ================= -->

<section class="search-area">

    <div class="search-box">

        <input
            type="text"
            id="searchInput"
            placeholder="🔎 Tìm kiếm sản phẩm..."
            onkeyup="searchProducts()"
        >

    </div>

</section>


<!-- ================= PRODUCTS ================= -->

<section class="products" id="products">

    <div class="section-title">

        <h2>Sản phẩm của chúng tôi</h2>

        <p>
            Chọn sản phẩm phù hợp với nhu cầu của bạn
        </p>

    </div>


    <div class="product-list" id="productList">


        <!-- DỊCH VỤ 01 -->

        <div class="product">

            <div class="product-icon">
                ⚡
            </div>

            <h3>
                Dịch vụ 01
            </h3>

            <p>
                Mô tả chi tiết dịch vụ 01.
            </p>

            <div class="price">
                10.000đ
            </div>

            <a href="/product/1" class="btn">
                Xem sản phẩm →
            </a>

        </div>


        <!-- DỊCH VỤ 02 -->

        <div class="product">

            <div class="popular">
                PHỔ BIẾN
            </div>

            <div class="product-icon">
                🔥
            </div>

            <h3>
                Dịch vụ 02
            </h3>

            <p>
                Mô tả chi tiết dịch vụ 02.
            </p>

            <div class="price">
                20.000đ
            </div>

            <a href="/product/2" class="btn">
                Xem sản phẩm →
            </a>

        </div>


        <!-- DỊCH VỤ 03 -->

        <div class="product">

            <div class="product-icon">
                💎
            </div>

            <h3>
                Dịch vụ 03
            </h3>

            <p>
                Mô tả chi tiết dịch vụ 03.
            </p>

            <div class="price">
                50.000đ
            </div>

            <a href="/product/3" class="btn">
                Xem sản phẩm →
            </a>

        </div>


    </div>

</section>


<!-- ================= NOTICE ================= -->

<section class="notice">

    <div class="notice-box">

        <h2>
            📢 Thông báo
        </h2>

        <p>
            Vui lòng kiểm tra kỹ thông tin trước khi đặt hàng.
            Nếu gặp vấn đề trong quá trình sử dụng dịch vụ,
            hãy liên hệ với chúng tôi để được hỗ trợ.
        </p>

    </div>

</section>


<!-- ================= INFO ================= -->

<section class="info">

    <div class="info-list">

        <div class="info-box">

            <div class="icon">
                ⚡
            </div>

            <h3>
                Nhanh chóng
            </h3>

            <p>
                Xử lý đơn hàng nhanh chóng và tiện lợi.
            </p>

        </div>


        <div class="info-box">

            <div class="icon">
                🔒
            </div>

            <h3>
                An toàn
            </h3>

            <p>
                Thông tin tài khoản và đơn hàng được bảo vệ.
            </p>

        </div>


        <div class="info-box">

            <div class="icon">
                💬
            </div>

            <h3>
                Hỗ trợ
            </h3>

            <p>
                Hỗ trợ khách hàng khi gặp vấn đề.
            </p>

        </div>

    </div>

</section>


<!-- ================= CONTACT ================= -->

<section class="contact" id="contact">

    <div class="contact-container">

        <div class="contact-title">

            <div class="contact-icon">
                💬
            </div>

            <h2>
                Liên hệ & Hỗ trợ
            </h2>

            <p>
                Cần hỗ trợ? Hãy liên hệ với Baro's Market.
            </p>

        </div>


        <div class="contact-list">


            <!-- DISCORD -->

            <a
                href="https://discord.gg/bYW8vNh7Q"
                target="_blank"
                rel="noopener noreferrer"
                class="contact-box"
            >

                <div class="contact-box-icon">
                    💬
                </div>

                <div>

                    <h3>
                        Discord
                    </h3>

                    <p>
                        Tham gia Discord để được hỗ trợ
                    </p>

                </div>

            </a>


            <!-- EMAIL -->

            <a
                href="mailto:support@baros-market.com"
                class="contact-box"
            >

                <div class="contact-box-icon">
                    📧
                </div>

                <div>

                    <h3>
                        Email
                    </h3>

                    <p>
                        support@baros-market.com
                    </p>

                </div>

            </a>


        </div>

    </div>

</section>


<!-- ================= FOOTER ================= -->

<footer>

    © 2026 Baro's Market — All rights reserved.

</footer>


<!-- ================= SEARCH SCRIPT ================= -->

<script>

function searchProducts() {

    const input =
        document
        .getElementById("searchInput")
        .value
        .toLowerCase();

    const products =
        document
        .querySelectorAll(".product");

    products.forEach(function(product) {

        const text =
            product.innerText.toLowerCase();

        if (text.includes(input)) {

            product.style.display = "";

        } else {

            product.style.display = "none";

        }

    });

}

</script>

</body>
</html>