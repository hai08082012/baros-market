```html
<!DOCTYPE html>
<html lang="vi">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Tài khoản - Baro's Market</title>

<style>

* {
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    margin: 0;
    background: #0b0d12;
    color: white;
}

header {
    height: 70px;
    display: flex;
    align-items: center;
    padding: 0 7%;
    background: #0f1117;
    border-bottom: 1px solid #242833;
}

.logo {
    font-size: 24px;
    font-weight: bold;
}

.logo span {
    color: #6c63ff;
}

nav {
    margin-left: 50px;
}

nav a {
    color: #aaa;
    text-decoration: none;
    margin-right: 25px;
}

nav a:hover {
    color: white;
}

.account-top {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
}

.balance-small {
    background: #191b27;
    border: 1px solid #292d38;
    padding: 9px 14px;
    border-radius: 8px;
    color: #8d87ff;
    font-weight: bold;
}

.logout {
    background: #252832;
    color: #aaa;
    padding: 9px 14px;
    border-radius: 8px;
    text-decoration: none;
}

.logout:hover {
    color: white;
}

.container {
    max-width: 1000px;
    margin: 45px auto;
    padding: 0 20px;
}

.profile {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

.box {
    background: #151821;
    border: 1px solid #292d38;
    border-radius: 16px;
    padding: 25px;
}

.profile-icon {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #211f45;
    border-radius: 50%;
    font-size: 28px;
    margin-bottom: 15px;
}

h1 {
    margin: 0 0 8px;
}

.email {
    color: #888;
}

.balance-title {
    color: #888;
    margin-bottom: 10px;
}

.balance {
    font-size: 38px;
    font-weight: bold;
    color: #6c63ff;
}

.balance-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.balance-box a {
    display: inline-block;
    margin-top: 20px;
    background: #6c63ff;
    color: white;
    text-decoration: none;
    padding: 12px 18px;
    border-radius: 8px;
    text-align: center;
}

.balance-box a:hover {
    background: #7b73ff;
}

.history {
    overflow-x: auto;
}

.history h2 {
    margin-top: 0;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 650px;
}

th {
    color: #888;
    font-weight: normal;
}

th,
td {
    padding: 15px 12px;
    border-bottom: 1px solid #292d38;
    text-align: left;
}

/* TIỀN */

.amount {
    font-weight: bold;
}

.amount.add {
    color: #55d68a;
}

.amount.remove {
    color: #ff6464;
}

.empty {
    color: #777;
    padding: 25px 0;
}

.back {
    display: inline-block;
    margin-top: 20px;
    color: #8d87ff;
    text-decoration: none;
}

.back:hover {
    color: white;
}

@media (max-width: 700px) {

    header {
        padding: 0 4%;
    }

    nav {
        display: none;
    }

    .profile {
        grid-template-columns: 1fr;
    }

    .container {
        margin-top: 25px;
    }

    .balance {
        font-size: 32px;
    }

    .account-top {
        gap: 5px;
    }

    .balance-small {
        padding: 8px 10px;
    }

    .logout {
        padding: 8px 10px;
    }

}

</style>

</head>


<body>


<header>

    <div class="logo">
        Baro's <span>Market</span>
    </div>


    <nav>

        <a href="/">
            Trang chủ
        </a>

        <a href="/#products">
            Dịch vụ
        </a>

    </nav>


    <div class="account-top">

        <div class="balance-small">

            💰
            <%= user.balance.toLocaleString("vi-VN") %>đ

        </div>


        <a href="/logout" class="logout">

            Đăng xuất

        </a>

    </div>

</header>



<div class="container">


    <div class="profile">


        <!-- THÔNG TIN TÀI KHOẢN -->

        <div class="box">

            <div class="profile-icon">
                👤
            </div>


            <h1>
                <%= user.username %>
            </h1>


            <div class="email">
                <%= user.email %>
            </div>

        </div>



        <!-- SỐ DƯ -->

        <div class="box balance-box">

            <div class="balance-title">
                Số dư tài khoản
            </div>


            <div class="balance">
                <%= user.balance.toLocaleString("vi-VN") %>đ
            </div>


            <a href="/deposit">
                💳 Nạp tiền
            </a>

        </div>

    </div>



    <!-- LỊCH SỬ -->

    <div class="box history">

        <h2>
            📋 Lịch sử giao dịch
        </h2>


        <% if (transactions.length === 0) { %>

            <div class="empty">
                Chưa có giao dịch nào.
            </div>

        <% } else { %>


            <table>

                <thead>

                    <tr>

                        <th>
                            Loại
                        </th>

                        <th>
                            Số tiền
                        </th>

                        <th>
                            Nội dung
                        </th>

                        <th>
                            Thời gian
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <% transactions.forEach(t => { %>

                    <tr>


                        <td>
                            <%= t.type %>
                        </td>


                        <td class="amount <%= t.amount >= 0 ? 'add' : 'remove' %>">

                            <% if (t.amount >= 0) { %>

                                +<%= Math.abs(t.amount).toLocaleString("vi-VN") %>đ

                            <% } else { %>

                                -<%= Math.abs(t.amount).toLocaleString("vi-VN") %>đ

                            <% } %>

                        </td>


                        <td>
                            <%= t.description %>
                        </td>


                        <td>
                            <%= t.time %>
                        </td>


                    </tr>

                    <% }) %>


                </tbody>

            </table>


        <% } %>


    </div>



    <a href="/" class="back">

        ← Về trang chủ

    </a>


</div>


</body>

</html>
```
