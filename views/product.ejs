<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= product.name %> - My Shop</title>

    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #0b0d12;
            color: white;
        }

        header {
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 8%;
            background: #0f1117;
            border-bottom: 1px solid #242833;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        .logo span {
            color: #6c63ff;
        }

        header a {
            color: #aaa;
            text-decoration: none;
        }

        header a:hover {
            color: white;
        }

        .page {
            max-width: 900px;
            margin: 70px auto;
            padding: 20px;
        }

        .product-card {
            background: #151821;
            border: 1px solid #292d38;
            border-radius: 18px;
            padding: 45px;
        }

        .icon {
            width: 75px;
            height: 75px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #201f45;
            border: 1px solid #39356f;
            border-radius: 18px;
            font-size: 35px;
            margin-bottom: 25px;
        }

        h1 {
            font-size: 38px;
            margin: 0 0 15px;
        }

        .description {
            color: #999;
            font-size: 17px;
            line-height: 1.7;
            margin-bottom: 25px;
        }

        .price {
            font-size: 30px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 14px 28px;
            background: #6c63ff;
            color: white;
            text-decoration: none;
            border-radius: 9px;
            font-weight: bold;
            transition: 0.2s;
        }

        .btn:hover {
            background: #7b73ff;
            transform: translateY(-2px);
        }

        .back {
            display: inline-block;
            margin-top: 25px;
            color: #888;
            text-decoration: none;
        }

        .back:hover {
            color: white;
        }

        .features {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 30px;
        }

        .feature {
            padding: 18px;
            background: #101218;
            border: 1px solid #292d38;
            border-radius: 10px;
            color: #aaa;
            text-align: center;
        }

        @media (max-width: 600px) {
            .page {
                margin: 30px auto;
            }

            .product-card {
                padding: 30px 20px;
            }

            h1 {
                font-size: 30px;
            }

            .features {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<header>

    <div class="logo">
        My <span>Shop</span>
    </div>

    <a href="/">
        Trang chủ
    </a>

</header>


<div class="page">

    <div class="product-card">

        <div class="icon">
            🛍️
        </div>

        <h1>
            <%= product.name %>
        </h1>

        <div class="description">
            <%= product.description %>
        </div>

        <div class="price">
            <%= product.price %>
        </div>

        <a href="/order/<%= product.id %>" class="btn">
            🛒 Mua ngay
        </a>

        <br>

        <a href="/" class="back">
            ← Quay lại trang chủ
        </a>


        <div class="features">

            <div class="feature">
                ⚡<br>
                Xử lý nhanh
            </div>

            <div class="feature">
                🔒<br>
                An toàn
            </div>

            <div class="feature">
                💬<br>
                Hỗ trợ
            </div>

        </div>

    </div>

</div>

</body>
</html>